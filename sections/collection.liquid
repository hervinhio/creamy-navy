{% comment %}
  This section is used in the collection template to render collection page
  listing all products within a collection.

  https://shopify.dev/docs/storefronts/themes/architecture/templates/collection
{% endcomment %}

<section class="collection-page">
  <h1 class="poltawski-nowy-h1 collection-page__title">{{ 'collections.available_products' | t }}</h1>

  {% paginate collection.products by 12 %}
    <div class="collection-products" style="--product-columns: {{ collection.products.size | at_most: 4 }}">
    {% for product in collection.products %}
      <article class="collection-product">
        <a class="collection-product__media" href="{{ product.url }}">
          {% if product.featured_image %}
            {{
              product.featured_image
              | image_url: width: 600
              | image_tag:
                class: 'collection-product__image',
                widths: '240, 360, 480, 600',
                sizes: '(max-width: 767px) 38vw, 13rem',
                loading: 'lazy'
            }}
          {% endif %}
        </a>

        <div class="collection-product__content">
          <h2>{{ product.title | escape | link_to: product.url }}</h2>
          <p class="collection-product__price">{{ product.price | money }}</p>
        </div>
      </article>
    {% endfor %}
    </div>

    {% if paginate.pages > 1 %}
      <div class="collection-pagination">
        {{ paginate | default_pagination }}
      </div>
    {% endif %}
  {% endpaginate %}
</section>

{% stylesheet %}
  .collection-page {
    min-height: calc(100svh - 7rem);
    padding: clamp(2rem, 5vw, 4.5rem) 0;
    background: var(--color-background);
    color: var(--color-foreground);
  }

  .collection-page__title {
    font-size: clamp(2rem, 3vw, 2.75rem);
    line-height: 1.1;
    text-align: center;
  }

  .collection-products {
    display: grid;
    grid-template-columns: repeat(var(--product-columns), minmax(10rem, 13rem));
    justify-content: center;
    gap: clamp(2.5rem, 6vw, 6rem) clamp(1rem, 4vw, 4rem);
    margin-top: clamp(5rem, 12vw, 8rem);
  }

  .collection-product {
    position: relative;
    min-width: 0;
    text-align: center;
    transform-origin: center;
    transition: transform 240ms ease;
  }

  .collection-product__media {
    display: grid;
    place-items: center;
    width: 100%;
    aspect-ratio: 1;
    overflow: hidden;
    border-radius: 50%;
    background: #ffe58a;
    transition: box-shadow 240ms ease;
  }

  .collection-product__image {
    width: 82%;
    height: 82%;
    object-fit: contain;
  }

  .collection-product__content {
    margin-top: 0.55rem;
  }

  .collection-product__content h2 {
    font-size: 1rem;
    font-weight: 700;
    line-height: 1.25;
  }

  .collection-product__content a {
    color: inherit;
    text-decoration: none;
  }

  .collection-product__price {
    margin-top: 0.7rem;
    font-size: 1rem;
    opacity: 0.8;
  }

  .collection-pagination {
    margin-top: 3rem;
    text-align: center;
  }

  .collection-pagination a {
    color: inherit;
  }

  @media (hover: hover) {
    .collection-product:hover,
    .collection-product:focus-within {
      z-index: 1;
      transform: translateY(-0.5rem) scale(1.04);
    }

    .collection-product:hover .collection-product__media,
    .collection-product:focus-within .collection-product__media {
      box-shadow: 0 1.25rem 2rem rgb(0 0 0 / 18%);
    }
  }

  @media (max-width: 47.99rem) {
    .collection-page {
      padding-top: 2rem;
    }

    .collection-products {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 2.5rem 1rem;
      margin-top: 3.5rem;
    }

    .collection-product__content h2,
    .collection-product__price {
      font-size: 0.875rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .collection-product,
    .collection-product__media {
      transition: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.collection",
  "settings": []
}
{% endschema %}
