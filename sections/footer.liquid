<footer class="footer full-width">
  <div class="footer__inner">
    <div class="footer__brand">
      <a class="footer__logo-link" href="{{ routes.root_url }}" aria-label="{{ 'header.brand_name' | t | escape }}">
        {% render 'brand-wordmark', variant: 'light' %}
      </a>
      <p class="footer__tagline">{{ 'footer.tagline' | t }}</p>
      <p class="footer__copyright">
        &copy; {{ 'now' | date: '%Y' }}, {{ 'header.brand_name' | t }}. {{ powered_by_link }}
      </p>
    </div>

    <nav class="footer__links" aria-label="{{ 'footer.primary_navigation' | t | escape }}">
      {% if section.settings.primary_menu.links != blank %}
        {% for link in section.settings.primary_menu.links %}
          {{ link.title | link_to: link.url }}
        {% endfor %}
      {% else %}
        <a href="{{ routes.all_products_collection_url }}">{{ 'footer.products' | t }}</a>
        <a href="{{ pages.boutiques.url | default: '/pages/boutiques' }}">{{ 'footer.stores' | t }}</a>
        <a href="{{ pages.trousseau.url | default: '/pages/trousseau' }}">{{ 'footer.school_list' | t }}</a>
        <a href="{{ pages.faq.url | default: '/pages/faq' }}">{{ 'footer.faq' | t }}</a>
      {% endif %}
    </nav>

    <nav class="footer__links" aria-label="{{ 'footer.secondary_navigation' | t | escape }}">
      {% if section.settings.secondary_menu.links != blank %}
        {% for link in section.settings.secondary_menu.links %}
          {{ link.title | link_to: link.url }}
        {% endfor %}
      {% else %}
        <a href="{{ pages.shipping.url | default: '/pages/shipping' }}">{{ 'footer.shipping' | t }}</a>
        <a href="{{ pages.returns.url | default: '/pages/returns' }}">{{ 'footer.returns' | t }}</a>
        <a href="{{ pages.contact.url | default: '/pages/contact' }}">{{ 'footer.contact' | t }}</a>
        {% if shop.privacy_policy.url != blank %}
          <a href="{{ shop.privacy_policy.url }}">{{ shop.privacy_policy.title }}</a>
        {% endif %}
        {% if shop.terms_of_service.url != blank %}
          <a href="{{ shop.terms_of_service.url }}">{{ shop.terms_of_service.title }}</a>
        {% endif %}
      {% endif %}
    </nav>

    <div class="footer__newsletter">
      <p class="footer__newsletter-title">{{ 'footer.newsletter_title' | t }}</p>
      {% form 'customer', class: 'footer__newsletter-form' %}
        <input type="hidden" name="contact[tags]" value="newsletter">
        <label class="visually-hidden" for="FooterEmail-{{ section.id }}">{{ 'footer.email' | t }}</label>
        <input
          id="FooterEmail-{{ section.id }}"
          type="email"
          name="contact[email]"
          value="{{ form.email }}"
          placeholder="{{ 'footer.email_placeholder' | t | escape }}"
          autocomplete="email"
          autocorrect="off"
          autocapitalize="off"
          required
        >
        <button type="submit" aria-label="{{ 'footer.newsletter_submit' | t | escape }}">
          <span class="material-symbols-outlined" aria-hidden="true">arrow_forward</span>
        </button>
        {% if form.posted_successfully? %}
          <p class="footer__form-message" tabindex="-1">{{ 'footer.newsletter_success' | t }}</p>
        {% elsif form.errors %}
          <p class="footer__form-message" tabindex="-1">{{ form.errors.translated_fields.email | capitalize }} {{ form.errors.messages.email }}</p>
        {% endif %}
      {% endform %}
      {% if shop.enabled_payment_types != blank %}
        <div class="footer__payments" aria-label="{{ 'footer.payment_methods' | t | escape }}">
          {% for type in shop.enabled_payment_types %}
            {{ type | payment_type_svg_tag }}
          {% endfor %}
        </div>
      {% endif %}
    </div>
  </div>
</footer>

{% stylesheet %}
  .footer {
    display: grid;
    grid-template-columns: var(--content-grid);
    min-height: 15.75rem;
    margin-top: 0;
    padding: 3.75rem 0;
    background: var(--palette-matted-old-charcoal);
    color: var(--palette-matted-old-cream);
  }

  .footer__inner {
    grid-column: 2;
    display: grid;
    grid-template-columns: minmax(15rem, 2fr) minmax(6rem, 0.7fr) minmax(6rem, 0.7fr) minmax(14rem, 1.3fr);
    gap: clamp(2rem, 6vw, 6rem);
    align-items: start;
    width: 100%;
  }

  .footer a {
    text-decoration: none;
    color: inherit;
  }

  .footer__logo-link {
    display: flex;
    width: fit-content;
    font-size: 3.5rem;
  }

  .footer__tagline,
  .footer__copyright {
    margin-top: 0.65rem;
    font-size: 0.75rem;
    line-height: 1.5;
  }

  .footer__links {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    padding-top: 0.55rem;
    font-size: 0.8rem;
  }

  .footer__newsletter {
    padding-top: 0.2rem;
  }

  .footer__newsletter-title {
    font-size: 0.8rem;
    font-weight: 700;
  }

  .footer__newsletter-form {
    position: relative;
    margin-top: 0.7rem;
  }

  .footer__newsletter-form input[type='email'] {
    width: 100%;
    min-height: 2rem;
    padding: 0.4rem 2.5rem 0.4rem 0.7rem;
    border: 1px solid var(--palette-matted-old-cream);
    border-radius: 0;
    background: transparent;
    color: var(--palette-matted-old-cream);
    font-size: 0.8rem;
  }

  .footer__newsletter-form button {
    position: absolute;
    top: 0;
    right: 0;
    display: grid;
    place-items: center;
    width: 2.25rem;
    height: 2rem;
    padding: 0;
    border: 0;
    background: transparent;
    color: var(--palette-matted-old-cream);
    cursor: pointer;
  }

  .footer__newsletter-form button .material-symbols-outlined {
    font-size: 1rem;
  }

  .footer__newsletter-form input::placeholder {
    color: rgb(238 233 219 / 70%);
    opacity: 1;
  }

  .footer__form-message {
    margin-top: 0.5rem;
    font-size: 0.75rem;
  }

  .footer__payments {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-top: 1rem;
  }

  .footer__payments svg {
    width: 2.4rem;
    height: auto;
  }

  .visually-hidden {
    position: absolute !important;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  @media (max-width: 47.99rem) {
    .footer {
      padding: 2.5rem 0;
    }

    .footer__inner {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 2rem 1.5rem;
    }

    .footer__brand,
    .footer__newsletter {
      grid-column: 1 / -1;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.footer",
  "settings": [
    {
      "type": "link_list",
      "id": "primary_menu",
      "label": "t:labels.primary_menu"
    },
    {
      "type": "link_list",
      "id": "secondary_menu",
      "label": "t:labels.secondary_menu"
    }
  ]
}
{% endschema %}
