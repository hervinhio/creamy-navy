<header>
  <h2 class="header__title">
    <a class="header__brand" href="{{ routes.root_url }}" aria-label="{{ 'header.brand_name' | t | escape }}">
      {% render 'brand-wordmark' %}
    </a>
  </h2>

  <div class="header__menu">
    {% for link in section.settings.menu.links %}
      {{ link.title | link_to: link.url }}
    {% endfor %}
  </div>

  <form class="header__search" action="{{ routes.search_url }}" method="get" role="search">
    <input type="hidden" name="options[prefix]" value="last">
    <input type="hidden" name="type" value="product">
    <input
      type="search"
      name="q"
      value="{{ search.terms | escape }}"
      placeholder="{{ 'search.placeholder' | t | escape }}"
      aria-label="{{ 'search.placeholder' | t | escape }}"
    >
    <button type="submit" aria-label="{{ 'search.submit' | t | escape }}">
      <span class="material-symbols-outlined" aria-hidden="true">search</span>
    </button>
  </form>

  <div class="header__icons">
    {% if shop.customer_accounts_enabled %}
      <shopify-account menu="{{ section.settings.customer_account_menu }}">
        {{ 'icon-account.svg' | inline_asset_content }}
      </shopify-account>
    {% endif %}

    <a href="{{ routes.cart_url }}">
      {% if cart.item_count > 0 %}
        <sup>{{ cart.item_count }}</sup>
      {% endif %}

      {{ 'icon-cart.svg' | inline_asset_content }}
    </a>
  </div>
</header>

{% stylesheet %}
  header {
    height: 5rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    background: var(--palette-matted-old-cream);
    color: var(--palette-matted-old-charcoal);
  }
  header a {
    position: relative;
    text-decoration: none;
    color: var(--palette-matted-old-charcoal);
    display: flex;
    align-items: center;
    justify-content: center;
  }
  header a sup {
    position: absolute;
    left: 100%;
    overflow: hidden;
    max-width: var(--page-margin);
  }
  header svg {
    width: 2rem;
    color: var(--palette-matted-old-charcoal);
  }
  header .header__brand {
    justify-content: flex-start;
    font-size: 3rem;
  }
  header .header__menu,
  header .header__icons {
    display: flex;
    gap: 1rem;
  }

  header .header__search {
    position: relative;
    display: flex;
    width: clamp(8rem, 24vw, 18rem);
    margin-left: auto;
  }

  header .header__search input[type='search'] {
    width: 100%;
    min-width: 0;
    height: 2.4rem;
    padding: 0.45rem 2.5rem 0.45rem 0.8rem;
    border: 1px solid rgb(68 68 68 / 35%);
    border-radius: 0.3rem;
    outline: 0;
    background: rgb(255 255 255 / 48%);
    color: var(--palette-matted-old-charcoal);
    font-family: 'Autour One', cursive;
    font-size: 0.74rem;
  }

  header .header__search input[type='search']:focus-visible {
    border-color: var(--palette-matted-old-blue);
    box-shadow: 0 0 0 2px var(--palette-matted-old-blue);
  }

  header .header__search button {
    position: absolute;
    top: 0;
    right: 0;
    display: grid;
    place-items: center;
    width: 2.4rem;
    height: 2.4rem;
    padding: 0;
    border: 0;
    background: transparent;
    color: var(--palette-matted-old-charcoal);
    cursor: pointer;
  }

  header .header__search .material-symbols-outlined {
    font-size: 1.2rem;
  }

  @media (max-width: 40rem) {
    header .header__menu {
      display: none;
    }

    header .header__search {
      width: min(9rem, 38vw);
    }

    header .header__search input[type='search'] {
      font-size: 0.68rem;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.header",
  "settings": [
    {
      "type": "link_list",
      "id": "menu",
      "label": "t:labels.menu"
    },
    {
      "type": "link_list",
      "id": "customer_account_menu",
      "label": "t:labels.customer_account_menu",
      "default": "customer-account-main-menu"
    }
  ]
}
{% endschema %}
