<back-to-school-countdown
  class="back-to-school full-width"
  data-deadline="{{ section.settings.deadline | escape }}"
>
  <div
    class="back-to-school__content"
    style="
      --school-doodles: url('{{ 'school-doodles-reference.svg' | asset_url }}');
      --wavy-background-horizontal: url('{{ 'wavy-background-horizontal.svg' | asset_url }}');
      --wavy-background-vertical: url('{{ 'wavy-background-vertical.svg' | asset_url }}');
    "
  >
    <div class="back-to-school__message">
      <p class="back-to-school__eyebrow">{{ 'home.back_to_school.eyebrow' | t }}</p>
      <h1 class="back-to-school__title">
        {% render 'brand-wordmark' %}
      </h1>
      <p class="back-to-school__description">{{ 'home.back_to_school.description' | t }}</p>
      <a class="back-to-school__primary-action" href="{{ routes.all_products_collection_url }}">
        {{ 'home.back_to_school.primary_action' | t }}
        <span class="material-symbols-outlined" aria-hidden="true">arrow_forward</span>
      </a>
    </div>

    {% capture countdown_caption_days %}<span data-countdown-caption-days>250</span>{% endcapture %}
    <div class="back-to-school__countdown" aria-label="{{ 'home.back_to_school.countdown' | t | escape }}">
      <p class="back-to-school__countdown-caption">
        <strong>{{ 'home.back_to_school.countdown_caption_html' | t: days: countdown_caption_days }}</strong>
        <span>{{ 'home.back_to_school.countdown_prompt' | t }}</span>
      </p>
      <div class="back-to-school__time">
        <strong data-countdown-days>250</strong>
        <span>{{ 'home.back_to_school.days' | t }}</span>
      </div>
      <div class="back-to-school__time">
        <strong data-countdown-hours>23</strong>
        <span>{{ 'home.back_to_school.hours' | t }}</span>
      </div>
      <div class="back-to-school__time">
        <strong data-countdown-minutes>14</strong>
        <span>{{ 'home.back_to_school.minutes' | t }}</span>
      </div>
      <div class="back-to-school__time">
        <strong data-countdown-seconds>00</strong>
        <span>{{ 'home.back_to_school.seconds' | t }}</span>
      </div>
    </div>

    <div class="back-to-school__services">
      <article class="back-to-school__service">
        <h2 class="back-to-school__service-title">
          <span class="material-symbols-outlined" aria-hidden="true">shopping_cart</span>
          {{ 'home.back_to_school.services.online.title' | t }}
        </h2>
        <p>{{ 'home.back_to_school.services.online.description' | t }}</p>
        <a class="back-to-school__service-action" href="{{ routes.all_products_collection_url }}">
          <span class="back-to-school__service-action-label">{{ 'home.back_to_school.services.online.action' | t }}</span>
          <span class="material-symbols-outlined" aria-hidden="true">arrow_forward</span>
        </a>
      </article>

      <article class="back-to-school__service">
        <h2 class="back-to-school__service-title">
          <span class="material-symbols-outlined" aria-hidden="true">storefront</span>
          {{ 'home.back_to_school.services.stores.title' | t }}
        </h2>
        <p>{{ 'home.back_to_school.services.stores.description' | t }}</p>
        <a class="back-to-school__service-action" href="{{ pages.boutiques.url | default: '/pages/boutiques' }}">
          <span class="back-to-school__service-action-label">{{ 'home.back_to_school.services.stores.action' | t }}</span>
          <span class="material-symbols-outlined" aria-hidden="true">arrow_forward</span>
        </a>
      </article>

      <article class="back-to-school__service">
        <h2 class="back-to-school__service-title">
          <span class="material-symbols-outlined" aria-hidden="true">list_alt</span>
          {{ 'home.back_to_school.services.school_list.title' | t }}
        </h2>
        <p>{{ 'home.back_to_school.services.school_list.description' | t }}</p>
        <a class="back-to-school__service-action" href="{{ pages.trousseau.url | default: '/pages/trousseau' }}">
          <span class="back-to-school__service-action-label">{{ 'home.back_to_school.services.school_list.action' | t }}</span>
          <span class="material-symbols-outlined" aria-hidden="true">arrow_forward</span>
        </a>
      </article>
    </div>
  </div>
</back-to-school-countdown>

<div class="home-commerce full-width">
  <aside class="home-trust" aria-label="{{ 'home.storefront.trust_label' | t | escape }}">
    <span><span class="material-symbols-outlined" aria-hidden="true">shopping_cart</span>{{ 'home.storefront.trust.online' | t }}</span>
    <span><span class="material-symbols-outlined" aria-hidden="true">storefront</span>{{ 'home.storefront.trust.pickup' | t }}</span>
    <span><span class="material-symbols-outlined" aria-hidden="true">list_alt</span>{{ 'home.storefront.trust.school_list' | t }}</span>
    <span><span class="material-symbols-outlined" aria-hidden="true">book_2</span>{{ 'home.storefront.trust.advice' | t }}</span>
  </aside>

  <section class="home-discovery" aria-labelledby="home-discovery-title">
    <div class="home-section-heading">
      <p>{{ 'home.storefront.discovery.eyebrow' | t }}</p>
      <h2 id="home-discovery-title">{{ 'home.storefront.discovery.title' | t }}</h2>
      <span>{{ 'home.storefront.discovery.description' | t }}</span>
    </div>

    {% assign category_handles = 'sacs,cahiers,livres,ecriture,arts-plastiques,fournitures' | split: ',' %}
    <div class="home-categories">
      {% for category_handle in category_handles %}
        {% assign category = collections[category_handle] %}
        {% assign category_image = category.image | default: category.products.first.featured_image %}
        {% capture category_translation_key %}home.storefront.discovery.categories.{{ category_handle | replace: '-', '_' }}{% endcapture %}
        {% case category_handle %}
          {% when 'sacs' %}
            {% assign category_photo_asset = 'category-backpacks.webp' %}
          {% when 'cahiers' %}
            {% assign category_photo_asset = 'category-notebooks.webp' %}
          {% when 'livres' %}
            {% assign category_photo_asset = 'category-books.webp' %}
          {% when 'ecriture' %}
            {% assign category_photo_asset = 'category-writing.webp' %}
          {% when 'arts-plastiques' %}
            {% assign category_photo_asset = 'category-art-supplies.jpg' %}
          {% when 'fournitures' %}
            {% assign category_photo_asset = 'category-school-supplies.jpg' %}
        {% endcase %}

        <a class="home-category" href="{{ category.url | default: routes.collections_url | append: '/' | append: category_handle }}">
          <span class="home-category__media">
            {% if category_image %}
              {{
                category_image
                | image_url: width: 640
                | image_tag:
                  class: 'home-category__image',
                  widths: '240, 360, 480, 640',
                  sizes: '(max-width: 639px) 44vw, (max-width: 1023px) 29vw, 15vw',
                  loading: 'eager'
              }}
            {% else %}
              <img
                class="home-category__image"
                src="{{ category_photo_asset | asset_url }}"
                alt="{{ category_translation_key | t | escape }}"
                width="900"
                height="720"
                loading="eager"
              >
            {% endif %}
          </span>
          <strong>{{ category_translation_key | t }}</strong>
          <span>{{ 'home.storefront.discovery.explore' | t }}</span>
        </a>
      {% endfor %}
    </div>
  </section>

  {% liquid
    assign featured_collection = section.settings.featured_collection
    if featured_collection == blank
      assign featured_collection = collections.fournitures
    endif
  %}
  {% if featured_collection.products != blank %}
    <section class="home-featured" aria-labelledby="home-featured-title">
      <div class="home-section-heading home-section-heading--light">
        <p>{{ 'home.storefront.featured.eyebrow' | t }}</p>
        <h2 id="home-featured-title">{{ 'home.storefront.featured.title' | t }}</h2>
        <a href="{{ featured_collection.url }}">
          {{ 'home.storefront.featured.view_all' | t }}
          <span class="material-symbols-outlined" aria-hidden="true">arrow_forward</span>
        </a>
      </div>

      <div class="home-products">
        {% for product in featured_collection.products limit: section.settings.product_limit %}
          {% assign selected_variant = product.selected_or_first_available_variant %}
          <article class="home-product">
            <a class="home-product__media" href="{{ product.url }}">
              {% if product.featured_image %}
                {{
                  product.featured_image
                  | image_url: width: 720
                  | image_tag:
                    class: 'home-product__image',
                    widths: '280, 440, 600, 720',
                    sizes: '(max-width: 639px) 44vw, (max-width: 1023px) 22vw, 18vw',
                    loading: 'lazy'
                }}
              {% endif %}
            </a>
            <div class="home-product__details">
              <h3>{{ product.title | escape | link_to: product.url }}</h3>
              <p>{{ product.price | money }}</p>
              {% if product.has_only_default_variant %}
                {% form 'product', product, class: 'home-product__form' %}
                  <input type="hidden" name="id" value="{{ selected_variant.id }}">
                  <input type="hidden" name="quantity" value="1">
                  <button class="button--secondary" type="submit" {% unless selected_variant.available %}disabled{% endunless %}>
                    {% if selected_variant.available %}
                      <span class="material-symbols-outlined" aria-hidden="true">add_shopping_cart</span>
                      {{ 'home.storefront.featured.add_to_cart' | t }}
                    {% else %}
                      {{ 'home.storefront.featured.sold_out' | t }}
                    {% endif %}
                  </button>
                {% endform %}
              {% else %}
                <a class="home-product__options" href="{{ product.url }}">
                  {{ 'home.storefront.featured.choose_options' | t }}
                  <span class="material-symbols-outlined" aria-hidden="true">arrow_forward</span>
                </a>
              {% endif %}
            </div>
          </article>
        {% endfor %}
      </div>
    </section>
  {% endif %}

  <section class="home-how-to-buy" aria-labelledby="home-how-to-buy-title">
    <div class="home-section-heading">
      <p>{{ 'home.storefront.how_to_buy.eyebrow' | t }}</p>
      <h2 id="home-how-to-buy-title">{{ 'home.storefront.how_to_buy.title' | t }}</h2>
      <span>{{ 'home.storefront.how_to_buy.description' | t }}</span>
    </div>
    <ol class="home-how-to-buy__steps">
      <li>
        <span class="material-symbols-outlined" aria-hidden="true">search</span>
        <strong>{{ 'home.storefront.how_to_buy.steps.choose_title' | t }}</strong>
        <p>{{ 'home.storefront.how_to_buy.steps.choose_description' | t }}</p>
      </li>
      <li>
        <span class="material-symbols-outlined" aria-hidden="true">shopping_cart</span>
        <strong>{{ 'home.storefront.how_to_buy.steps.cart_title' | t }}</strong>
        <p>{{ 'home.storefront.how_to_buy.steps.cart_description' | t }}</p>
      </li>
      <li>
        <span class="material-symbols-outlined" aria-hidden="true">storefront</span>
        <strong>{{ 'home.storefront.how_to_buy.steps.fulfillment_title' | t }}</strong>
        <p>{{ 'home.storefront.how_to_buy.steps.fulfillment_description' | t }}</p>
      </li>
      <li>
        <span class="material-symbols-outlined" aria-hidden="true">inventory_2</span>
        <strong>{{ 'home.storefront.how_to_buy.steps.receive_title' | t }}</strong>
        <p>{{ 'home.storefront.how_to_buy.steps.receive_description' | t }}</p>
      </li>
    </ol>
  </section>

  <section class="home-school-list" aria-labelledby="home-school-list-title">
    <div class="home-school-list__intro">
      <span class="material-symbols-outlined" aria-hidden="true">list_alt</span>
      <p>{{ 'home.storefront.school_list.eyebrow' | t }}</p>
      <h2 id="home-school-list-title">{{ 'home.storefront.school_list.title' | t }}</h2>
      <span>{{ 'home.storefront.school_list.description' | t }}</span>
      <a href="{{ pages.trousseau.url | default: '/pages/trousseau' }}">
        {{ 'home.storefront.school_list.action' | t }}
        <span class="material-symbols-outlined" aria-hidden="true">arrow_forward</span>
      </a>
    </div>
    <ol class="home-school-list__steps">
      <li><strong>1</strong><span>{{ 'home.storefront.school_list.steps.send' | t }}</span></li>
      <li><strong>2</strong><span>{{ 'home.storefront.school_list.steps.prepare' | t }}</span></li>
      <li><strong>3</strong><span>{{ 'home.storefront.school_list.steps.collect' | t }}</span></li>
    </ol>
  </section>

  <section class="home-credibility" aria-labelledby="home-credibility-title">
    <div class="home-section-heading">
      <p>{{ 'home.storefront.credibility.eyebrow' | t }}</p>
      <h2 id="home-credibility-title">{{ 'home.storefront.credibility.title' | t }}</h2>
      <span>{{ 'home.storefront.credibility.description' | t }}</span>
    </div>
    <div class="home-credibility__groups">
      <article>
        <span class="material-symbols-outlined" aria-hidden="true">family_restroom</span>
        <h3>{{ 'home.storefront.credibility.parents.title' | t }}</h3>
        <p>{{ 'home.storefront.credibility.parents.description' | t }}</p>
      </article>
      <article>
        <span class="material-symbols-outlined" aria-hidden="true">school</span>
        <h3>{{ 'home.storefront.credibility.schools.title' | t }}</h3>
        <p>{{ 'home.storefront.credibility.schools.description' | t }}</p>
      </article>
      <article>
        <span class="material-symbols-outlined" aria-hidden="true">account_balance</span>
        <h3>{{ 'home.storefront.credibility.organizations.title' | t }}</h3>
        <p>{{ 'home.storefront.credibility.organizations.description' | t }}</p>
      </article>
    </div>
  </section>
</div>

{% stylesheet %}
  .back-to-school {
    display: block;
    min-height: calc(100svh - 5rem);
    overflow: hidden;
    background: var(--palette-matted-old-cream);
    color: var(--palette-matted-old-charcoal);
    font-family: 'Autour One', cursive;
  }

  .back-to-school__content {
    --hero-column-left: clamp(1.5rem, 5vw, 4.5rem);
    --hero-column-width: min(29rem, 47%);

    position: relative;
    min-width: 0;
    min-height: calc(100svh - 5rem);
    overflow: hidden;
    background-color: var(--palette-matted-old-cream);
    background-image: var(--wavy-background-vertical), var(--school-doodles);
    background-position: right center, 61.5% center;
    background-repeat: no-repeat, no-repeat;
    background-size: 53% 100%, auto 92%;
    font-family: 'Autour One', cursive;
  }

  @media (min-width: 90rem) {
    .back-to-school__content {
      background-size: 47% 100%, auto 92%;
    }
  }

  .back-to-school__message {
    position: absolute;
    z-index: 1;
    top: 36%;
    left: var(--hero-column-left);
    width: var(--hero-column-width);
    transform: translateY(-50%);
  }

  .back-to-school__eyebrow {
    margin-bottom: 0.75rem;
    color: var(--palette-matted-old-crimson);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0;
    text-transform: uppercase;
  }

  .back-to-school__title {
    font-family: 'Reenie Beanie', cursive;
    font-size: clamp(6rem, 11.75vw, 8.5rem);
    font-weight: 400;
    line-height: 0.7;
    letter-spacing: 0;
    white-space: nowrap;
  }

  .back-to-school__description {
    margin-top: 1.75rem;
    font-size: 1.06rem;
    line-height: 1.35;
  }

  .back-to-school__primary-action {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    width: fit-content;
    margin: 1.25rem auto 0;
    padding: 0.8rem 1.25rem;
    border: 0;
    border-radius: 0.35rem;
    outline: 0;
    background: #ddc173;
    color: var(--palette-matted-old-charcoal);
    font-size: 0.94rem;
    font-weight: 700;
    text-decoration: none;
  }

  .back-to-school__primary-action .material-symbols-outlined {
    font-size: 1.1rem;
  }

  .back-to-school__service-action:focus-visible {
    outline: 3px solid currentcolor;
    outline-offset: 3px;
  }

  .back-to-school__primary-action:focus-visible {
    box-shadow: 0 0 0 3px var(--palette-matted-old-charcoal);
  }

  .back-to-school__countdown {
    position: absolute;
    z-index: 1;
    top: 61%;
    left: calc(var(--hero-column-left) + var(--hero-column-width) / 2);
    display: grid;
    grid-template-columns: repeat(4, 4.65rem);
    gap: 0.5rem 0.65rem;
    transform: translateX(-50%);
  }

  .back-to-school__time {
    position: relative;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    width: 4.65rem;
    aspect-ratio: 1.15;
    border-radius: 0.4rem;
    background: #eee9db;
    box-shadow: 0 0.35rem 0.55rem rgb(68 68 68 / 38%), 0 0.1rem 0.18rem rgb(68 68 68 / 30%);
    color: #444444;
    text-align: center;
  }

  .back-to-school__time strong {
    position: relative;
    display: block;
    width: 100%;
    height: 2rem;
    min-width: 2ch;
    font-size: 1.75rem;
    font-weight: 400;
    line-height: 1;
    perspective: 8rem;
  }

  .back-to-school__flip-half {
    position: absolute;
    right: 0;
    left: 0;
    height: 50%;
    overflow: hidden;
    background: #eee9db;
    backface-visibility: hidden;
    transform-style: preserve-3d;
  }

  .back-to-school__flip-half > span {
    position: absolute;
    right: 0;
    left: 0;
    height: 2rem;
    line-height: 2rem;
  }

  .back-to-school__flip-half--top {
    top: 0;
    border-bottom: 1px solid rgb(68 68 68 / 24%);
  }

  .back-to-school__flip-half--top > span {
    top: 0;
  }

  .back-to-school__flip-half--bottom {
    bottom: 0;
    box-shadow: inset 0 1px rgb(255 255 255 / 55%);
  }

  .back-to-school__flip-half--bottom > span {
    bottom: 0;
  }

  .back-to-school__flip-half--flap-top {
    z-index: 2;
    transform-origin: bottom;
  }

  .back-to-school__flip-half--flap-bottom {
    z-index: 2;
    transform: rotateX(90deg);
    transform-origin: top;
  }

  .back-to-school__time strong.is-flipping .back-to-school__flip-half--flap-top {
    animation: back-to-school-flip-top 220ms cubic-bezier(0.55, 0.06, 0.68, 0.19) forwards;
  }

  .back-to-school__time strong.is-flipping .back-to-school__flip-half--flap-bottom {
    animation: back-to-school-flip-bottom 220ms 220ms cubic-bezier(0.22, 0.61, 0.36, 1) forwards;
  }

  .back-to-school__time > span {
    margin-top: 0.3rem;
    font-size: 0.7rem;
    line-height: 1;
  }

  .back-to-school__countdown-caption {
    grid-column: 1 / -1;
    margin: 0 0 0.2rem;
    color: #444444;
    font-size: 0.7rem;
    line-height: 1.3;
    text-align: center;
  }

  .back-to-school__countdown-caption strong,
  .back-to-school__countdown-caption span {
    display: block;
  }

  .back-to-school__countdown-caption strong {
    font-weight: 700;
  }

  @keyframes back-to-school-flip-top {
    0% {
      filter: brightness(1);
      transform: rotateX(0);
    }

    100% {
      filter: brightness(0.82);
      transform: rotateX(-90deg);
    }
  }

  @keyframes back-to-school-flip-bottom {
    0% {
      filter: brightness(0.82);
      transform: rotateX(90deg);
    }

    100% {
      filter: brightness(1);
      transform: rotateX(0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .back-to-school__time strong.is-flipping .back-to-school__flip-half {
      animation: none;
    }

    .back-to-school__flip-half--flap-top,
    .back-to-school__flip-half--flap-bottom {
      display: none;
    }
  }

  .back-to-school__services {
    position: absolute;
    top: 50%;
    right: clamp(1.5rem, 4vw, 4rem);
    display: grid;
    align-content: center;
    gap: clamp(2.5rem, 6vh, 4rem);
    width: min(34%, 24rem);
    height: min(68%, 32rem);
    transform: translateY(-50%);
    color: var(--palette-matted-old-cream);
    text-align: center;
  }

  .back-to-school__service-title {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.55rem;
    font-size: clamp(1.35rem, 1.6vw, 1.6rem);
    font-weight: 400;
    line-height: 1.1;
  }

  .back-to-school__service {
    display: grid;
    justify-items: center;
    min-height: 7rem;
  }

  .back-to-school__service:nth-child(2) {
    transform: translateX(-1.75rem);
  }

  .back-to-school__service:nth-child(3) {
    transform: translateX(-3.5rem);
  }

  .back-to-school__service-title .material-symbols-outlined {
    flex: 0 0 auto;
    font-size: 1.7rem;
  }

  .back-to-school__service p {
    max-width: 24rem;
    margin: 0.55rem auto 0;
    font-size: 0.78rem;
    line-height: 1.35;
  }

  .back-to-school__service-action {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    margin-top: 0.55rem;
    color: inherit;
    font-size: 0.76rem;
    font-weight: 700;
    text-decoration: none;
  }

  .back-to-school__service-action-label {
    text-decoration: underline;
    text-underline-offset: 0.2rem;
  }

  .back-to-school__service-action .material-symbols-outlined {
    font-size: 1rem;
  }

  @media (max-width: 70rem), (orientation: portrait) {
    .back-to-school__content {
      min-height: max(calc(100svh - 5rem), 44rem);
      background-image: var(--wavy-background-horizontal);
      background-position: center bottom;
      background-size: 100% 48%;
    }

    .back-to-school__message {
      top: 17%;
      left: 50%;
      width: min(29rem, calc(100% - 2rem));
      transform: translate(-50%, -50%);
    }

    .back-to-school__title {
      font-size: clamp(4.5rem, 10vw, 6rem);
      white-space: nowrap;
    }

    .back-to-school__description {
      margin-top: 1.25rem;
      font-size: 1rem;
      line-height: 1.35;
    }

    .back-to-school__countdown {
      top: 35%;
      left: 50%;
      grid-template-columns: repeat(4, min(4rem, 18vw));
      gap: 0.4rem;
      transform: translateX(-50%);
    }

    .back-to-school__time {
      width: min(4rem, 18vw);
    }

    .back-to-school__time strong {
      font-size: 1.4rem;
    }

    .back-to-school__services {
      top: 79%;
