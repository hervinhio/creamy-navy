{% javascript %}
  class BackToSchoolCountdown extends HTMLElement {
    connectedCallback() {
      this.deadline = new Date(this.dataset.deadline).getTime()
      this.days = this.querySelector('[data-countdown-days]')
      this.captionDays = this.querySelector('[data-countdown-caption-days]')
      this.hours = this.querySelector('[data-countdown-hours]')
      this.minutes = this.querySelector('[data-countdown-minutes]')
      this.seconds = this.querySelector('[data-countdown-seconds]')

      if (Number.isNaN(this.deadline)) return

      ;[this.days, this.hours, this.minutes, this.seconds].forEach((element) => this.buildFlipFace(element))
      this.update()
      this.interval = window.setInterval(() => this.update(), 1000)
    }

    disconnectedCallback() {
      window.clearInterval(this.interval)
    }

    update() {
      const remaining = Math.max(0, this.deadline - Date.now())
      const totalSeconds = Math.floor(remaining / 1000)
      this.daysRemaining = Math.floor(totalSeconds / 86400)

      this.captionDays.textContent = this.daysRemaining
      this.setValue(this.days, this.daysRemaining)
      this.setValue(this.hours, Math.floor((totalSeconds % 86400) / 3600))
      this.setValue(this.minutes, Math.floor((totalSeconds % 3600) / 60))
      this.setValue(this.seconds, totalSeconds % 60)

      if (remaining === 0) window.clearInterval(this.interval)
    }

    setValue(element, value) {
      const formattedValue = element === this.days ? String(value) : String(value).padStart(2, '0')
      const previousValue = element.dataset.value

      if (previousValue === formattedValue) return

      element.querySelector('[data-flip-current-top]').textContent = formattedValue
      element.querySelector('[data-flip-current-bottom]').textContent = formattedValue
      element.querySelector('[data-flip-previous-top]').textContent = previousValue
      element.querySelector('[data-flip-next-bottom]').textContent = formattedValue
      element.dataset.value = formattedValue
      element.setAttribute('aria-label', formattedValue)
      element.classList.remove('is-flipping')
      void element.offsetWidth
      element.classList.add('is-flipping')
    }

    buildFlipFace(element) {
      const initialValue = element.textContent.trim()

      element.dataset.value = initialValue
      element.textContent = ''
      element.insertAdjacentHTML(
        'beforeend',
        `<span class="back-to-school__flip-half back-to-school__flip-half--top" aria-hidden="true"><span data-flip-current-top>${initialValue}</span></span>
          <span class="back-to-school__flip-half back-to-school__flip-half--bottom" aria-hidden="true"><span data-flip-current-bottom>${initialValue}</span></span>
          <span class="back-to-school__flip-half back-to-school__flip-half--top back-to-school__flip-half--flap-top" aria-hidden="true"><span data-flip-previous-top>${initialValue}</span></span>
          <span class="back-to-school__flip-half back-to-school__flip-half--bottom back-to-school__flip-half--flap-bottom" aria-hidden="true"><span data-flip-next-bottom>${initialValue}</span></span>`,
      )
    }
  }

  if (!customElements.get('back-to-school-countdown')) {
    customElements.define('back-to-school-countdown', BackToSchoolCountdown)
  }
{% endjavascript %}

