<back-to-school-countdown
  class="back-to-school full-width"
  data-deadline="{{ section.settings.deadline | escape }}"
>
  <nav class="back-to-school__rail" aria-label="{{ 'home.back_to_school.navigation' | t | escape }}">
    <a
      class="back-to-school__rail-link is-active"
      href="{{ routes.root_url }}"
      aria-label="{{ 'home.back_to_school.categories.news' | t | escape }}"
    >
      <span class="material-symbols-outlined" aria-hidden="true">home</span>
      <span class="back-to-school__rail-label">{{ 'home.back_to_school.categories.news' | t }}</span>
    </a>
    <a
      class="back-to-school__rail-link"
      href="{{ routes.collections_url | append: '/cahiers' }}"
      aria-label="{{ 'home.back_to_school.categories.notebooks' | t | escape }}"
    >
      <span class="material-symbols-outlined" aria-hidden="true">book_ribbon</span>
      <span class="back-to-school__rail-label">{{ 'home.back_to_school.categories.notebooks' | t }}</span>
    </a>
    <a
      class="back-to-school__rail-link"
      href="{{ routes.collections_url | append: '/sacs' }}"
      aria-label="{{ 'home.back_to_school.categories.bags' | t | escape }}"
    >
      <span class="material-symbols-outlined" aria-hidden="true">backpack</span>
      <span class="back-to-school__rail-label">{{ 'home.back_to_school.categories.bags' | t }}</span>
    </a>
    <a
      class="back-to-school__rail-link"
      href="{{ routes.collections_url | append: '/livres' }}"
      aria-label="{{ 'home.back_to_school.categories.books' | t | escape }}"
    >
      <span class="material-symbols-outlined" aria-hidden="true">book_2</span>
      <span class="back-to-school__rail-label">{{ 'home.back_to_school.categories.books' | t }}</span>
    </a>
    <a
      class="back-to-school__rail-link"
      href="{{ routes.collections_url | append: '/utilitaires' }}"
      aria-label="{{ 'home.back_to_school.categories.supplies' | t | escape }}"
    >
      <span class="material-symbols-outlined" aria-hidden="true">architecture</span>
      <span class="back-to-school__rail-label">{{ 'home.back_to_school.categories.supplies' | t }}</span>
    </a>
  </nav>

  <div
    class="back-to-school__content"
    style="
      --wavy-background-horizontal: url('{{ 'wavy-background-horizontal.svg' | asset_url }}');
      --wavy-background-vertical: url('{{ 'wavy-background-vertical.svg' | asset_url }}');
    "
  >
    <div class="back-to-school__message">
      <h1 class="back-to-school__title">{{ 'home.back_to_school.title' | t }}</h1>
      <p class="back-to-school__description">{{ 'home.back_to_school.description' | t }}</p>
    </div>

    <div class="back-to-school__countdown" aria-label="{{ 'home.back_to_school.countdown' | t | escape }}">
      <div class="back-to-school__time">
        <strong data-countdown-days>250</strong>
        <span>{{ 'home.back_to_school.days' | t }}</span>
      </div>
      <div class="back-to-school__time">
        <strong data-countdown-hours>23</strong>
        <span>{{ 'home.back_to_school.hours' | t }}</span>
      </div>
      <div class="back-to-school__time">
        <strong data-countdown-minutes>14</strong>
        <span>{{ 'home.back_to_school.minutes' | t }}</span>
      </div>
    </div>

    <div class="back-to-school__services">
      <article class="back-to-school__service">
        <h2 class="back-to-school__service-title">
          <span class="material-symbols-outlined" aria-hidden="true">shopping_cart</span>
          {{ 'home.back_to_school.services.online.title' | t }}
        </h2>
        <p>{{ 'home.back_to_school.services.online.description' | t }}</p>
      </article>

      <article class="back-to-school__service">
        <h2 class="back-to-school__service-title">
          <span class="material-symbols-outlined" aria-hidden="true">storefront</span>
          {{ 'home.back_to_school.services.stores.title' | t }}
        </h2>
        <p>{{ 'home.back_to_school.services.stores.description' | t }}</p>
      </article>

      <article class="back-to-school__service">
        <h2 class="back-to-school__service-title">
          <span class="material-symbols-outlined" aria-hidden="true">list_alt</span>
          {{ 'home.back_to_school.services.school_list.title' | t }}
        </h2>
        <p>{{ 'home.back_to_school.services.school_list.description' | t }}</p>
      </article>
    </div>
  </div>
</back-to-school-countdown>

{% stylesheet %}
  .back-to-school {
    display: grid;
    grid-template-columns: 3rem minmax(0, 1fr);
    min-height: calc(100svh - 5rem);
    overflow: hidden;
    background: var(--palette-matted-old-cream);
    color: var(--palette-matted-old-charcoal);
    font-family: 'Autour One', cursive;
  }

  .back-to-school__rail {
    grid-column: 1;
    align-self: end;
    display: grid;
    grid-template-rows: repeat(5, minmax(5rem, 1fr));
    width: 100%;
    height: 78svh;
  }

  .back-to-school__rail-link {
    position: relative;
    display: flex;
    flex-direction: column-reverse;
    align-items: center;
    justify-content: center;
    gap: 0.35rem;
    min-height: 0;
    box-shadow:
      0 0.2rem 0.4rem -0.1rem color-mix(in srgb, var(--palette-matted-old-charcoal) 30%, transparent),
      inset -0.55rem 0 0.8rem -0.4rem color-mix(in srgb, var(--palette-matted-old-charcoal) 55%, transparent);
    color: var(--palette-matted-old-cream);
    font-family: 'Autour One', cursive;
    font-size: 1.1rem;
    line-height: 1;
    text-decoration: none;
  }

  .back-to-school__rail-link .material-symbols-outlined {
    font-size: 1.65rem;
    font-variation-settings:
      'FILL' 0,
      'wght' 400,
      'GRAD' 0,
      'opsz' 24;
  }

  .back-to-school__rail-label {
    font-size: 0.75rem;
    font-weight: 700;
    writing-mode: vertical-rl;
    transform: rotate(180deg);
  }

  .back-to-school__rail-link:nth-child(1) {
    z-index: 5;
    border-radius: 0 1rem 0 0;
    background: var(--palette-matted-old-crimson);
  }

  .back-to-school__rail-link:nth-child(2) {
    z-index: 4;
    background: var(--palette-matted-old-blue);
  }

  .back-to-school__rail-link:nth-child(3) {
    z-index: 3;
    background: var(--palette-matted-old-cream);
    color: var(--palette-matted-old-charcoal);
  }

  .back-to-school__rail-link:nth-child(4) {
    z-index: 2;
    background: var(--palette-matted-old-gray);
    color: var(--palette-matted-old-charcoal);
  }

  .back-to-school__rail-link:nth-child(5) {
    z-index: 1;
    box-shadow: inset -0.55rem 0 0.8rem -0.4rem color-mix(in srgb, var(--palette-matted-old-charcoal) 55%, transparent);
    background: var(--palette-matted-old-charcoal);
  }

  .back-to-school__rail-link:focus-visible {
    outline: 3px solid var(--palette-matted-old-cream);
    outline-offset: -5px;
  }

  .back-to-school__content {
    position: relative;
    grid-column: 2;
    min-width: 0;
    min-height: calc(100svh - 5rem);
    overflow: hidden;
    background-color: var(--palette-matted-old-cream);
    background-image: var(--wavy-background-vertical);
    background-position: right center;
    background-repeat: no-repeat;
    background-size: 53% 100%;
    font-family: 'Autour One', cursive;
  }

  @media (min-width: 90rem) {
    .back-to-school__content {
      background-size: 47% 100%;
    }
  }

  .back-to-school__message {
    position: absolute;
    z-index: 1;
    top: 36%;
    left: clamp(1.5rem, 5vw, 4.5rem);
    width: min(29rem, 47%);
    transform: translateY(-50%);
  }

  .back-to-school__title {
    font-family: 'Reenie Beanie', cursive;
    font-size: clamp(6rem, 11.75vw, 8.5rem);
    font-weight: 400;
    line-height: 0.7;
    letter-spacing: 0;
    white-space: nowrap;
  }

  .back-to-school__description {
    margin-top: 1.75rem;
    font-size: 1.06rem;
    line-height: 1.35;
  }

  .back-to-school__countdown {
    position: absolute;
    z-index: 1;
    top: 61%;
    left: clamp(3rem, 7vw, 6rem);
    display: flex;
    gap: 0.65rem;
  }

  .back-to-school__time {
    display: grid;
    place-content: center;
    width: 4.65rem;
    aspect-ratio: 1.15;
    border-radius: 0.4rem;
    background: var(--palette-matted-old-gray);
    text-align: center;
  }

  .back-to-school__time strong {
    font-size: 1.75rem;
    font-weight: 400;
    line-height: 1;
  }

  .back-to-school__time span {
    margin-top: 0.3rem;
    font-size: 0.7rem;
    line-height: 1;
  }

  .back-to-school__services {
    position: absolute;
    top: 50%;
    right: clamp(1.5rem, 4vw, 4rem);
    display: grid;
    align-content: space-between;
    width: min(34%, 24rem);
    height: min(72%, 34rem);
    transform: translateY(-50%);
    color: var(--palette-matted-old-cream);
    text-align: center;
  }

  .back-to-school__service-title {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.55rem;
    font-size: 1.1rem;
    font-weight: 400;
    line-height: 1.1;
  }

  .back-to-school__service:nth-child(2) {
    transform: translateX(-1.75rem);
  }

  .back-to-school__service:nth-child(3) {
    transform: translateX(-3.5rem);
  }

  .back-to-school__service-title .material-symbols-outlined {
    flex: 0 0 auto;
    font-size: 1.45rem;
  }

  .back-to-school__service p {
    max-width: 24rem;
    margin: 0.55rem auto 0;
    font-size: 0.78rem;
    line-height: 1.35;
  }

  @media (max-width: 70rem), (orientation: portrait) {
    .back-to-school__content {
      min-height: max(calc(100svh - 5rem), 44rem);
      background-image: var(--wavy-background-horizontal);
      background-position: center bottom;
      background-size: 100% 65%;
    }

    .back-to-school__message {
      top: 17%;
      left: 50%;
      width: min(29rem, calc(100% - 2rem));
      transform: translate(-50%, -50%);
    }

    .back-to-school__title {
      font-size: clamp(4.5rem, 10vw, 6rem);
      white-space: nowrap;
    }

    .back-to-school__description {
      margin-top: 1.25rem;
      font-size: 1rem;
      line-height: 1.35;
    }

    .back-to-school__countdown {
      top: 35%;
      left: 50%;
      gap: 0.4rem;
      transform: translateX(-50%);
    }

    .back-to-school__time {
      width: min(4rem, 20vw);
    }

    .back-to-school__time strong {
      font-size: 1.4rem;
    }

    .back-to-school__services {
      top: 70%;
      right: auto;
      left: 50%;
      width: min(30rem, calc(100% - 2rem));
      height: 50%;
      transform: translate(-50%, -50%);
    }

    .back-to-school__service-title {
      font-size: 1rem;
    }

    .back-to-school__service:nth-child(2),
    .back-to-school__service:nth-child(3) {
      transform: none;
    }

    .back-to-school__service p {
      margin-top: 0.35rem;
      font-size: 0.78rem;
    }
  }

  @media (max-width: 40rem) {
    .back-to-school {
      grid-template-columns: 2.65rem minmax(0, 1fr);
    }

    .back-to-school__rail {
      height: 82svh;
    }

    .back-to-school__rail-link {
      font-size: 0.9rem;
    }

    .back-to-school__rail-label {
      display: none;
    }

    .back-to-school__message {
      width: min(21rem, calc(100% - 2rem));
    }

    .back-to-school__title {
      font-size: clamp(2.75rem, 19vw, 5.5rem);
    }

    .back-to-school__description {
      font-size: 0.9rem;
    }

    .back-to-school__services {
      width: min(22rem, calc(100% - 2rem));
    }

    .back-to-school__service p {
      font-size: 0.72rem;
    }
  }
{% endstylesheet %}

{% javascript %}
  class BackToSchoolCountdown extends HTMLElement {
    connectedCallback() {
      this.deadline = new Date(this.dataset.deadline).getTime()
      this.days = this.querySelector('[data-countdown-days]')
      this.hours = this.querySelector('[data-countdown-hours]')
      this.minutes = this.querySelector('[data-countdown-minutes]')

      if (Number.isNaN(this.deadline)) return

      this.update()
      this.interval = window.setInterval(() => this.update(), 60000)
    }

    disconnectedCallback() {
      window.clearInterval(this.interval)
    }

    update() {
      const remaining = Math.max(0, this.deadline - Date.now())
      const totalMinutes = Math.floor(remaining / 60000)

      this.days.textContent = Math.floor(totalMinutes / 1440)
      this.hours.textContent = Math.floor((totalMinutes % 1440) / 60)
      this.minutes.textContent = totalMinutes % 60

      if (remaining === 0) window.clearInterval(this.interval)
    }
  }

  if (!customElements.get('back-to-school-countdown')) {
    customElements.define('back-to-school-countdown', BackToSchoolCountdown)
  }
{% endjavascript %}

{% schema %}
{
  "name": "t:general.back_to_school",
  "settings": [
    {
      "type": "text",
      "id": "deadline",
      "label": "t:labels.countdown_deadline",
      "info": "t:info.countdown_deadline",
      "default": "2027-06-02T00:00:00+02:00"
    }
  ],
  "presets": [
    {
      "name": "t:general.back_to_school"
    }
  ]
}
{% endschema %}
